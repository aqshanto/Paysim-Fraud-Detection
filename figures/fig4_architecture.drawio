<mxfile host="app.diagrams.net"><diagram id="architecture" name="Architecture"><mxGraphModel dx="1320" dy="740" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="740" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a11" value="Input and feature construction" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;verticalAlign=top;align=center;fontStyle=2;fontSize=14;spacingTop=4;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="300" height="640" as="geometry"/></mxCell><mxCell id="a12" value="&lt;b&gt;Transaction record&lt;/b&gt;&lt;br&gt;step, type, amount,&lt;br&gt;oldbalanceOrg, newbalanceOrig,&lt;br&gt;oldbalanceDest, newbalanceDest" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=4;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="260" height="84" as="geometry"/></mxCell><mxCell id="a13" value="&lt;b&gt;Preprocessing&lt;/b&gt;&lt;br&gt;&amp;#8226; keep TRANSFER, CASH-OUT&lt;br&gt;&amp;#8226; drop account IDs, isFlaggedFraud&lt;br&gt;&amp;#8226; type &amp;#8594; 1 (TRANSFER) / 0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=4;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="168" width="260" height="84" as="geometry"/></mxCell><mxCell id="a14" value="&lt;b&gt;Feature construction&lt;/b&gt;&lt;br&gt;empties_amount = 1[amount = oldbalanceOrg]&lt;br&gt;dest_zero = 1[both receiver balances = 0]&lt;br&gt;is_whole = 1[amount mod 1 = 0]&lt;br&gt;hour = step mod 24" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=4;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="276" width="260" height="110" as="geometry"/></mxCell><mxCell id="a15" value="&lt;b&gt;Two alternative feature sets&lt;/b&gt;&lt;br&gt;&lt;b&gt;A, with balance&lt;/b&gt; (10): type, amount,&lt;br&gt;4 balances, empties_amount, dest_zero,&lt;br&gt;is_whole, hour&lt;br&gt;&lt;b&gt;B, without balance&lt;/b&gt; (4): type, amount,&lt;br&gt;is_whole, hour (dataset documentation)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=4;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="260" height="156" as="geometry"/></mxCell><mxCell id="a16" value="&lt;b&gt;Split&lt;/b&gt;: random, group-aware,&lt;br&gt;chronological, expanding window" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#000000;fontSize=12;align=center;spacingLeft=8;spacingRight=4;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="260" height="50" as="geometry"/></mxCell><mxCell id="a17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="a12" target="a13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="a13" target="a14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="a14" target="a15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="a15" target="a16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a21" value="Detection models and parameters" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;verticalAlign=top;align=center;fontStyle=2;fontSize=14;spacingTop=4;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="360" y="20" width="620" height="640" as="geometry"/></mxCell><mxCell id="a22" value="&lt;b&gt;Expert-driven rule&lt;/b&gt; (no training)&lt;br&gt;fraud &amp;#8660; empties_amount = 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;dashed=1;dashPattern=6 3;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=8;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="580" height="50" as="geometry"/></mxCell><mxCell id="a23" value="&lt;b&gt;Logistic regression&lt;/b&gt;&lt;br&gt;StandardScaler (mean and variance learned on training data only) &amp;#8594; p = &amp;#963;(w&lt;sup&gt;T&lt;/sup&gt;x + b)&lt;br&gt;L2 penalty, C = 1.0, solver lbfgs, max_iter = 1000" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=4;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="380" y="128" width="580" height="64" as="geometry"/></mxCell><mxCell id="a24" value="&lt;b&gt;Random forest&lt;/b&gt;&lt;br&gt;100 trees, each grown on a bootstrap sample; &amp;#8730;p features tried at each split; no depth limit&lt;br&gt;p = mean of the tree probabilities" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=4;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="380" y="210" width="580" height="64" as="geometry"/></mxCell><mxCell id="a25" value="&lt;b&gt;Histogram gradient boosting&lt;/b&gt;&lt;br&gt;1. bin each feature into at most 255 bins&lt;br&gt;2. add trees one by one; each tree fits the gradient of the log-loss&lt;br&gt;3. leaf value = &amp;#8722;G / (H + &amp;#955;)&amp;#160;&amp;#160;(G, H: sums of gradients and Hessians in the leaf)&lt;br&gt;4. update F(x) &amp;#8592; F(x) + &amp;#951; &amp;#183; tree(x);&amp;#160;&amp;#160;p = &amp;#963;(F(x))&lt;br&gt;5. early stopping: stop when the loss on a 10% validation split stops improving" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=4;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="380" y="292" width="580" height="118" as="geometry"/></mxCell><mxCell id="a26" value="&lt;b&gt;Gradient boosting settings compared&lt;/b&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;default&lt;/b&gt;: &amp;#951; = 0.1, &amp;#955; = 0, unlimited depth (31 leaves), early stopping&lt;br&gt;&amp;#8226; &lt;b&gt;L2 = 1.0&lt;/b&gt;: &amp;#955; = 1 shrinks every leaf value&lt;br&gt;&amp;#8226; &lt;b&gt;max depth 3&lt;/b&gt;: each tree uses at most 3 splits on a path&lt;br&gt;&amp;#8226; &lt;b&gt;learning rate 0.05&lt;/b&gt;: smaller step &amp;#951; per tree&lt;br&gt;&amp;#8226; &lt;b&gt;no early stopping&lt;/b&gt;: all 100 iterations are used" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=4;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="380" y="428" width="580" height="110" as="geometry"/></mxCell><mxCell id="a27" value="&lt;b&gt;Effect of the settings&lt;/b&gt; (chronological split)&lt;br&gt;Without constraints, leaf values grow large on nearly separable data, so F(x) becomes extreme and p saturates at 0 or 1: 412 large frauds receive p = 0.0 (recall 0.903); without early stopping recall falls to 0.055.&lt;br&gt;Shrinking leaf values (&amp;#955; = 1) or limiting depth avoids this: F1 = 0.9999." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#f7f7f7;strokeColor=#7f7f7f;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="380" y="556" width="580" height="76" as="geometry"/></mxCell><mxCell id="a28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="a25" target="a26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="a26" target="a27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a30" value="Decision and evaluation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;verticalAlign=top;align=center;fontStyle=2;fontSize=14;spacingTop=4;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1020" y="20" width="280" height="640" as="geometry"/></mxCell><mxCell id="a31" value="&lt;b&gt;Decision&lt;/b&gt;&lt;br&gt;fraud if p &amp;#8805; 0.5" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#000000;fontSize=12;align=center;spacingLeft=8;spacingRight=4;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1040" y="160" width="240" height="56" as="geometry"/></mxCell><mxCell id="a32" value="&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;&amp;#8226; precision, recall, F1&lt;br&gt;&amp;#8226; PR-AUC&lt;br&gt;&amp;#8226; missed frauds, false alarms" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=4;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1040" y="260" width="240" height="90" as="geometry"/></mxCell><mxCell id="a33" value="&lt;b&gt;Analyses&lt;/b&gt;&lt;br&gt;&amp;#8226; ablation of features&lt;br&gt;&amp;#8226; feature importance&lt;br&gt;&amp;#8226; with vs. without balance&lt;br&gt;&amp;#8226; rule vs. models" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=4;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1040" y="390" width="240" height="104" as="geometry"/></mxCell><mxCell id="a34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="a31" target="a32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;fontSize=11;" edge="1" parent="1" source="a32" target="a33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;" edge="1" parent="1" source="a23" target="a31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;" edge="1" parent="1" source="a24" target="a31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;" edge="1" parent="1" source="a25" target="a31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;fontSize=11;" edge="1" parent="1" source="a22" target="a32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="85"/><mxPoint x="1000" y="287"/></Array></mxGeometry></mxCell><mxCell id="a40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;" edge="1" parent="1" source="a16" target="a22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="615"/><mxPoint x="340" y="85"/></Array></mxGeometry></mxCell><mxCell id="a41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;" edge="1" parent="1" source="a16" target="a23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="615"/><mxPoint x="340" y="160"/></Array></mxGeometry></mxCell><mxCell id="a42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;" edge="1" parent="1" source="a16" target="a24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="615"/><mxPoint x="340" y="242"/></Array></mxGeometry></mxCell><mxCell id="a43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;strokeWidth=1;fontFamily=Times New Roman;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;" edge="1" parent="1" source="a16" target="a25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="615"/><mxPoint x="340" y="351"/></Array></mxGeometry></mxCell><mxCell id="a44" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="1280" height="40" as="geometry"/></mxCell><mxCell id="a45" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;dashed=1;dashPattern=6 3;strokeWidth=1.5;fontSize=12;align=left;spacingLeft=8;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="50" y="690" width="40" height="20" as="geometry"/></mxCell><mxCell id="a46" value="Expert-driven rule" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="100" y="690" width="150" height="20" as="geometry"/></mxCell><mxCell id="a47" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=4;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="280" y="690" width="40" height="20" as="geometry"/></mxCell><mxCell id="a48" value="Data-driven model / processing step" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="330" y="690" width="260" height="20" as="geometry"/></mxCell><mxCell id="a49" value="" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#f7f7f7;strokeColor=#7f7f7f;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="620" y="688" width="30" height="24" as="geometry"/></mxCell><mxCell id="a50" value="Observed effect of a parameter change" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="660" y="690" width="280" height="20" as="geometry"/></mxCell><mxCell id="a51" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=left;spacingLeft=8;spacingRight=4;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="960" y="690" width="40" height="20" as="geometry"/></mxCell><mxCell id="a52" value="Input, feature set or setting" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1010" y="690" width="240" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>